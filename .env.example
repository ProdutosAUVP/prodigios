# Base path do build. Padrão: "/" na Vercel (detecta VERCEL=1) e "/prodigios/" no GitHub Pages.
# VITE_BASE=/

# Endpoint que recebe o formulário de inscrição (Formspree, Getform, n8n, etc).
# Sem ele o formulário roda em modo demonstração (mostra a confirmação sem enviar).
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Link externo de inscrição (ATS, Gupy, Typeform...). Se definido, o botão
# "Quero me inscrever" do topo/hero aponta para ele em vez da âncora #inscricao.
# VITE_APPLY_URL=https://
